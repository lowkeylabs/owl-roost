"""
Workspace capability checks.

Notes
-----
Owns reusable predicates describing
the current state of a workspace.

Architectural Invariant
-----------------------

Checks answer semantic questions
about a workspace.

Checks do NOT mutate the workspace.

Checks are intended for reuse by:

    workspace.operations
    review.service
    future notebooks
    future Quarto workflows

Validation should defer to OWL
whenever practical rather than
reimplementing OWL logic.
"""

from __future__ import annotations

from pathlib import Path

from owlroost.workspace.owl_utils import (
    validate_household,
)

# =========================================================
# Discovery Helpers
# =========================================================


def find_household_files(
    root=".",
):
    """
    Discover household definition
    files.

    Notes
    -----
    Workspace metadata files are
    excluded.
    """

    root = Path(
        root,
    )

    return sorted(
        path
        for path in root.glob(
            "*.toml",
        )
        if path.name != "workspace.toml"
    )


def find_hfp_files(
    root=".",
):
    """
    Discover HFP workbooks.
    """

    root = Path(
        root,
    )

    return sorted(
        root.glob(
            "*.xlsx",
        ),
    )


# =========================================================
# Workspace Status
# =========================================================


def has_workspace(
    root=".",
):
    """
    Does this directory contain a
    workspace definition?
    """

    root = Path(
        root,
    )

    return (
        root / "workspace.toml"
    ).exists()


def is_initialized(
    root=".",
):
    """
    Has this directory been
    initialized as a ROOST
    workspace?
    """

    return has_workspace(
        root,
    )


# =========================================================
# Household Discovery
# =========================================================


def has_toml(
    root=".",
):
    """
    Does at least one household
    TOML exist?
    """

    return (
        len(
            find_household_files(
                root,
            )
        )
        > 0
    )


def has_single_toml(
    root=".",
):
    """
    Exactly one household TOML
    exists.
    """

    return (
        len(
            find_household_files(
                root,
            )
        )
        == 1
    )


def has_multiple_toml(
    root=".",
):
    """
    More than one household TOML
    exists.
    """

    return (
        len(
            find_household_files(
                root,
            )
        )
        > 1
    )


def has_hfp(
    root=".",
):
    """
    Does at least one HFP workbook
    exist?
    """

    return (
        len(
            find_hfp_files(
                root,
            )
        )
        > 0
    )


def has_single_hfp(
    root=".",
):
    """
    Exactly one HFP workbook
    exists.
    """

    return (
        len(
            find_hfp_files(
                root,
            )
        )
        == 1
    )


def has_multiple_hfp(
    root=".",
):
    """
    More than one HFP workbook
    exists.
    """

    return (
        len(
            find_hfp_files(
                root,
            )
        )
        > 1
    )


# =========================================================
# Workspace Readiness
# =========================================================


def has_household(
    root=".",
):
    """
    Does this workspace contain
    exactly one household?
    """

    return has_single_toml(
        root,
    )


def has_valid_household(
    root=".",
):
    """
    Can OWL successfully construct
    a household Plan?

    Validation is delegated to
    native OWL functionality.
    """

    households = find_household_files(
        root,
    )

    if len(
        households,
    ) != 1:
        return False

    return validate_household(
        households[0],
    )


# =========================================================
# Workspace Inventory
# =========================================================


def has_cases(
    root=".",
):
    """
    Does the workspace contain a
    cases directory?
    """

    root = Path(
        root,
    )

    return (
        root / "cases"
    ).exists()


def has_results(
    root=".",
):
    """
    Does the workspace contain a
    results directory?
    """

    root = Path(
        root,
    )

    return (
        root / "results"
    ).exists()


def has_reports(
    root=".",
):
    """
    Does the workspace contain a
    reports directory?
    """

    root = Path(
        root,
    )

    return (
        root / "reports"
    ).exists()
